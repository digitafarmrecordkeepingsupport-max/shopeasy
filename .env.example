# ====================================================================
# ShopEasy Environment Variables Configuration
# ====================================================================

# 1. Supabase Public Client Configuration (Mobile App & Admin Web)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# 2. Supabase Server-Side Secret Key (DO NOT EXPOSE IN CLIENT BUNDLES)
# Used only by admin provisioning scripts & edge functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# 3. Paystack Payment Gateway (Nigeria NGN)
# Obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=pk_test_...your-paystack-public-key
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...your-paystack-public-key
PAYSTACK_SECRET_KEY=sk_test_...your-paystack-secret-key

# 4. MongoDB Database Configuration
# Obtain connection string from MongoDB Atlas (mongodb+srv://...) or local MongoDB instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopeasy?retryWrites=true&w=majority

# 5. Cloudinary Image & Media Storage Configuration
# Obtain from Cloudinary Dashboard -> Settings -> Access Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=shopeasy_preset

# 6. Backend API URL (for mobile Expo app)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# 7. Ngrok Tunnel (Optional for remote Expo Go preview on mobile data)
NGROK_AUTHTOKEN=your-ngrok-token-here
